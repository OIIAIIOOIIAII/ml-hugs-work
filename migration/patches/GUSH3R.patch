+def compose_overlapped_chunk_renders(window_records, output_dir, expected_frames):
+    """Linearly compose overlapping *rendered* windows into one indexed sequence.
+
+    This is deliberately a diagnostic seam control, not a map-fusion solution:
+    an overlap uses future frames from the next window and blending RGB can hide
+    rather than repair geometric disagreement.  It is useful to quantify how
+    much of the boundary jump is merely a hard render switch before implementing
+    an online anchor-map hand-off.
+    """
+    frames_dir = os.path.join(output_dir, "merged_render")
+    os.makedirs(frames_dir, exist_ok=True)
+    for frame_index in range(expected_frames):
+        accumulator = None
+        total_weight = 0.0
+        for record in window_records:
+            start, end = record["start"], record["end_exclusive"]
+            if not start <= frame_index < end:
+                continue
+            local_index = frame_index - start
+            overlap = record["overlap"]
+            weight = 1.0
+            if overlap > 0 and start > 0 and local_index < overlap:
+                weight *= (local_index + 1) / (overlap + 1)
+            if overlap > 0 and end < expected_frames and local_index >= (end - start - overlap):
+                weight *= (end - frame_index) / (overlap + 1)
+            frame_path = os.path.join(record["render_dir"], "merged_render", f"frame_{local_index:06d}.png")
+            frame = imageio.imread(frame_path).astype(np.float32)
+            accumulator = frame * weight if accumulator is None else accumulator + frame * weight
+            total_weight += weight
+        if accumulator is None or total_weight <= 0:
+            raise RuntimeError(f"No window render available for global frame {frame_index}")
+        composed = np.clip(np.rint(accumulator / total_weight), 0, 255).astype(np.uint8)
+        imageio.imwrite(os.path.join(frames_dir, f"frame_{frame_index:06d}.png"), composed)
+
