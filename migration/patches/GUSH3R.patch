+def _contact_gaussian_sample(gaussians, max_gaussians, kind):
+    """Compact numerical Gaussian evidence; never serializes renderer images."""
+    if gaussians is None:
+        return {}
+    if kind == "scene":
+        xyz = gaussians.means.view(-1, 3)
+        scales = gaussians.scales.view(-1, 3)
+        rotations = gaussians.rotations.view(-1, 4)
+        opacity = gaussians.opacities.view(-1)
+    else:
+        xyz = gaussians.xyz.view(-1, 3)
+        scales = gaussians.scaling.view(-1, 3)
+        rotations = gaussians.rotation.view(-1, 4)
+        opacity = gaussians.opacity.view(-1)
+    count = len(xyz)
+    if count == 0:
+        return {f"{kind}_count": np.asarray(0, np.int64)}
+    keep = min(int(max_gaussians), count)
+    indices = torch.topk(opacity, k=keep, sorted=False).indices
+    return {
+        f"{kind}_count": np.asarray(count, np.int64),
+        f"{kind}_xyz": xyz[indices].detach().float().cpu().numpy(),
+        f"{kind}_scales": scales[indices].detach().float().cpu().numpy(),
+        f"{kind}_rotations": rotations[indices].detach().float().cpu().numpy(),
+        f"{kind}_opacity": opacity[indices].detach().float().cpu().numpy(),
+    }
+
+
+def export_contact_state(outputs, output_dir, max_gaussians):
+    """Write a frozen-backbone evidence contract for causal contact research.
+
+    The export intentionally contains no RGB pixels and does not claim that
+    Gaussian centers are surfaces.  Downstream code must construct local
+    patches and use covariance/opacity as evidence and reliability only.
+    """
+    evidence_dir = os.path.join(output_dir, "contact_state")
+    os.makedirs(evidence_dir, exist_ok=False)
+    records = []
+    for frame_index, prediction in enumerate(outputs["pred"]):
+        payload = {}
+        payload.update(_contact_gaussian_sample(prediction.get("gaussians"), max_gaussians, "scene"))
+        payload.update(_contact_gaussian_sample(prediction.get("human_gaussians"), max_gaussians, "human"))
+        # These small tensors provide coarse pose/visual-contact evidence.  A
+        # large mask/image-shaped field is deliberately not exported here.
+        for key in ("smpl_shape", "smpl_rotmat", "smpl_transl", "smpl_expression", "smpl_scores", "smpl_loc", "camera_pose"):
+            value = prediction.get(key)
+            if torch.is_tensor(value) and value.numel() <= 100_000:
+                payload[key] = value.detach().float().cpu().numpy()
+        filename = f"{frame_index:06d}.npz"
+        np.savez_compressed(os.path.join(evidence_dir, filename), **payload)
+        records.append({
+            "frame": frame_index,
+            "file": filename,
+            "scene_count": int(payload.get("scene_count", 0)),
+            "human_count": int(payload.get("human_count", 0)),
+            "scene_saved": int(len(payload.get("scene_xyz", []))),
+            "human_saved": int(len(payload.get("human_xyz", []))),
+        })
+    manifest = {
+        "schema": "hugs.forward_contact.gush3r_evidence.v1",
+        "input": "frozen GUSH3R forward output",
+        "contact_rule": "Gaussian centers are not surfaces; use sampled attributes only as local relation/reliability evidence.",
+        "max_gaussians_per_kind": int(max_gaussians),
+        "frames": records,
+    }
+    with open(os.path.join(evidence_dir, "manifest.json"), "w", encoding="utf-8") as handle:
+        json.dump(manifest, handle, indent=2)
+    print(f"Saved numerical contact-state evidence: {evidence_dir}")
+
